# These are provided automatically when you connect a Vercel Postgres
# (Neon) database to your Vercel project — you don't need to set them by
# hand in production. For local development, run `vercel env pull .env.local`
# to fetch them.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Set this yourself in the Vercel project's Environment Variables settings.
# It protects the one-time POST /api/seed endpoint from being triggered by
# anyone who happens to find the URL.
SEED_SECRET=
